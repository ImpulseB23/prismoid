{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prismoid",
  "version": "0.8.5",
  "identifier": "org.prismoid.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' https: data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    },
    "windows": [
      {
        "title": "Prismoid",
        "width": 560,
        "height": 900,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NDVCOTkxMzk3Njk1RTcKUldUbmxYWTVrYmxGRnl0QnBpN0J3TUszS0hsb0hOcmltYitrcCtDQlVNVUxQUE5aS25uZkErQ3kK",
      "endpoints": [
        "https://github.com/ImpulseB23/Prismoid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "prismoid"
        ]
      }
    }
  }
}
